diff --git a/packages/lib/server-only/user/disable-reported-sender.ts b/packages/lib/server-only/user/disable-reported-sender.ts
new file mode 100644
index 00000000000..af3117bc55d
--- /dev/null
+++ b/packages/lib/server-only/user/disable-reported-sender.ts
@@ -0,0 +1,71 @@
+import { prisma } from '@documenso/prisma';
+
+import { jobsClient } from '../../jobs/client';
+import { logger } from '../../utils/logger';
+import { shouldDisableReportedSender } from '../../utils/sender-trust';
+import { disableUser } from './disable-user';
+
+export type DisableReportedSenderOptions = {
+  envelopeId: string;
+};
+
+export const disableReportedSender = async ({ envelopeId }: DisableReportedSenderOptions): Promise<boolean> => {
+  const envelope = await prisma.envelope.findFirst({
+    where: {
+      id: envelopeId,
+    },
+    select: {
+      id: true,
+      user: {
+        select: {
+          id: true,
+          disabled: true,
+          roles: true,
+        },
+      },
+      team: {
+        select: {
+          organisation: {
+            select: {
+              organisationClaim: {
+                select: {
+                  originalSubscriptionClaimId: true,
+                },
+              },
+            },
+          },
+        },
+      },
+    },
+  });
+
+  if (!envelope) {
+    return false;
+  }
+
+  const { user } = envelope;
+  const { organisationClaim } = envelope.team.organisation;
+
+  if (!shouldDisableReportedSender({ user, organisationClaim })) {
+    return false;
+  }
+
+  await disableUser({ id: user.id });
+
+  logger.warn({
+    msg: 'Sender automatically disabled after a signing request was reported',
+    userId: user.id,
+    envelopeId: envelope.id,
+  });
+
+  await jobsClient.triggerJob({
+    name: 'send.account.disabled.email',
+    payload: {
+      userId: user.id,
+      reason: 'SIGNING_REQUEST_REPORTED',
+      envelopeId: envelope.id,
+    },
+  });
+
+  return true;
+};
diff --git a/packages/lib/utils/sender-trust.ts b/packages/lib/utils/sender-trust.ts
new file mode 100644
index 00000000000..8c2d30a04a9
--- /dev/null
+++ b/packages/lib/utils/sender-trust.ts
@@ -0,0 +1,47 @@
+import type { OrganisationClaim } from '@prisma/client';
+
+import { IS_DOCUMENSO_CLOUD } from '../constants/app';
+import { ONE_HOUR } from '../constants/time';
+import { INTERNAL_CLAIM_ID } from '../types/subscription';
+import { env } from './env';
+
+const NEW_ACCOUNT_PERIOD = ONE_HOUR * 48;
+
+type OrganisationClaimPlan = Pick<OrganisationClaim, 'originalSubscriptionClaimId'>;
+
+export type ShouldShowNewAccountWarningOptions = {
+  userCreatedAt: Date;
+  organisationClaim: OrganisationClaimPlan;
+};
+
+export const shouldShowNewAccountWarning = ({
+  userCreatedAt,
+  organisationClaim,
+}: ShouldShowNewAccountWarningOptions) => {
+  const isEnabled = IS_DOCUMENSO_CLOUD() || env('NEXT_PRIVATE_SHOW_NEW_ACCOUNT_EMAIL_WARNING') === 'true';
+
+  if (!isEnabled || organisationClaim.originalSubscriptionClaimId !== INTERNAL_CLAIM_ID.FREE) {
+    return false;
+  }
+
+  return Date.now() - userCreatedAt.getTime() < NEW_ACCOUNT_PERIOD;
+};
+
+export type ShouldDisableReportedSenderOptions = {
+  user: {
+    disabled: boolean;
+    roles: Array<'ADMIN' | 'USER'>;
+  };
+  organisationClaim: OrganisationClaimPlan;
+};
+
+/**
+ * Cloud only: every self-hosted organisation is on the free claim.
+ */
+export const shouldDisableReportedSender = ({ user, organisationClaim }: ShouldDisableReportedSenderOptions) => {
+  if (!IS_DOCUMENSO_CLOUD() || user.disabled || user.roles.includes('ADMIN')) {
+    return false;
+  }
+
+  return organisationClaim.originalSubscriptionClaimId === INTERNAL_CLAIM_ID.FREE;
+};
